{
  "name": "pixel-realms-mmo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:realtime": "npm run dev --workspace @pixel-realms/realtime",
    "build": "next build",
    "build:realtime": "npm run build --workspace @pixel-realms/realtime",
    "build:all": "npm run build && npm run build:realtime",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @pixel-realms/realtime",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:all"
  },
  "dependencies": {
    "@pixel-realms/game-core": "*",
    "@pixel-realms/protocol": "*",
    "next": "16.2.10",
    "phaser": "3.90.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
